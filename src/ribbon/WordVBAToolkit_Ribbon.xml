<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <!-- Tools group -->
      <tab id="tabWordVBAToolkit" label="WordVBAToolkit">
        <group id="grpToolkit" label="Toolkit List">
          <!-- Tool N°1 Text formatting
          On click show the Text formatting form -->
          <button id="btnTextFormat"
                  label="Text formatting"
                  imageMso="GroupFont"
                  size="large"
                  onAction="LaunchTextFormattingForm" />
          <!-- Tool N°2 Table from list button
          On click show the Table from list form -->        
          <button id="btnWordTable"
                  label="Table from list"
                  imageMso="XmlImport"
                  size="large"
                  onAction="LaunchTableFromListForm" />
        </group>
        <!-- About group -->
        <group id="grpAbout" label="About">
          <!-- About button
          On click show the About form-->
          <button id="btnAbout" 
                  label="About"
                  imageMso="Info" 
                  size="large"
                  onAction="OnAboutClick" />
          <!-- Update button
          Is visible only when a new version is available on the repository-->
          <button id="btnUpdate"
                  getLabel="GetUpdateLabel"
                  getVisible="GetUpdateVisible"
                  imageMso="Refresh"
                  size="large"
                  onAction="OnUpdateClick" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>